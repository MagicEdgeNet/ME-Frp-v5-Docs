{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "incremental": true, "tsBuildInfoFile": "node_modules/.cache/docs.tsbuildinfo", "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client"], "baseUrl": ".", "paths": { "@/*": ["src/*"] },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "manifest.json"]
}
