{
  "name": "me-frp-v5-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "docs:check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test tests/unit/*.test.*",
    "test:build": "MEFRP_CHECK_DIST=1 node --test tests/unit/docs.test.mjs",
    "test:browser": "node tests/acceptance/docs.browser.cjs"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.65.0",
    "sass-embedded": "^1.108.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@10.32.1"
}
