{
  "name": "me-frp-v5-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24", "pnpm": ">=10" },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "docs:check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test tests/unit/*.test.*",
    "test:build": "MEFRP_CHECK_DIST=1 node --test tests/unit/docs.test.mjs",
    "test:browser": "node tests/acceptance/docs.browser.cjs"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.58.2",
    "sass-embedded": "^1.106.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@10.32.1"
}
